diff --git a/tests/gateway/test_clarify_voice_origin_timeout.py b/tests/gateway/test_clarify_voice_origin_timeout.py
new file mode 100644
index 00000000..2a870a92
--- /dev/null
+++ b/tests/gateway/test_clarify_voice_origin_timeout.py
@@ -0,0 +1,31 @@
+"""Origin-aware clarify timeout: a voice-origin question auto-cancels in minutes,
+a text-origin question keeps the configured window. The order flow reads the voice
+timeout as the user's "cancel" choice (see the marketplace-order-flow skill)."""
+
+from tools import clarify_gateway as cm
+
+
+CFG = {"clarify": {"timeout": 3600, "voice_timeout": 180}}
+
+
+def test_voice_origin_uses_voice_timeout_and_text_keeps_window():
+    assert cm.resolve_clarify_timeout(CFG, "voice") == 180
+    assert cm.resolve_clarify_timeout(CFG, "text") == 3600
+    assert cm.resolve_clarify_timeout(CFG) == 3600  # no origin recorded
+
+
+def test_session_origin_lookup_and_legacy_no_arg_call():
+    cm.record_inbound_kind("sk-voice", "voice")
+    cm.record_inbound_kind("sk-text", "text")
+    assert cm.get_inbound_kind("sk-voice") == "voice"
+    # The origin lookup must not break callers that pass no session key.
+    assert cm.get_clarify_timeout() == 3600
+    # Unknown session -> the configured window, not the voice one.
+    assert cm.get_clarify_timeout("sk-unknown") == 3600
+
+
+def test_voice_timeout_falls_back_when_unset_or_non_numeric():
+    assert cm.resolve_clarify_timeout({"clarify": {"timeout": 600}}, "voice") == 180
+    assert cm.resolve_clarify_timeout({"clarify": {"voice_timeout": "x", "timeout": 600}}, "voice") == 180
+    # An explicit 0 stays verbatim (unlimited) for text origin.
+    assert cm.resolve_clarify_timeout({"clarify": {"timeout": 0}}, "text") == 0
