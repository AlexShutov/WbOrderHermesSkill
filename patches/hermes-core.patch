+# Origin-aware clarify timeout. A question raised from a VOICE message expires after
+# ``clarify.voice_timeout`` (default 180s): a user who sent a voice note and went quiet is
+# busy and has most likely decided not to buy, so the pending order flow must not sit armed
+# for an hour — the timeout is read as the user's "cancel" choice by the flow that asked.
+# A TEXT-origin question keeps the configured window (no voice-style auto-cancel).
+# Recorded per session at inbound dispatch; the next inbound message overwrites it, so it always
+# describes the message that raised the current question (a button click is not an inbound message).
+_session_kind: dict[str, str] = {}
+
+
+def record_inbound_kind(session_key: str, kind: str) -> None:
+    """Remember the inbound message kind ("voice"/"text") for a session's clarify timeout."""
+    if session_key:
+        _session_kind[session_key] = str(kind or "")
+
+
+def get_inbound_kind(session_key: str) -> str:
+    return _session_kind.get(session_key or "", "")
+
+
+def _voice_timeout(config: dict) -> int:
+    raw = (config.get("clarify") or {}).get("voice_timeout", 180)
+    try:
+        return int(raw)
+    except (TypeError, ValueError):
+        return 180
+
+
+def resolve_clarify_timeout(config: dict, kind: str = "") -> int:
     """Clarify timeout (seconds): legacy ``clarify.timeout`` if explicitly set, else
     ``agent.clarify_timeout``, else 3600 — the single source of truth for every surface
-    (gateway, CLI, TUI). ``<= 0`` is kept verbatim (unlimited); non-numeric -> 3600."""
+    (gateway, CLI, TUI). ``<= 0`` is kept verbatim (unlimited); non-numeric -> 3600.
+    A ``voice`` origin uses ``clarify.voice_timeout`` instead (see above)."""
+    if kind == "voice":
+        return _voice_timeout(config)
     raw = (config.get("clarify") or {}).get("timeout")
     if raw is None:
         raw = (config.get("agent") or {}).get("clarify_timeout", 3600)
@@ -273,16 +304,17 @@ def resolve_clarify_timeout(config: dict) -> int:
